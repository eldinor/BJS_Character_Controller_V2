{
  "name": "@bjs-cc/litecc",
  "version": "0.1.0",
  "description": "A Babylon Lite + Havok character controller.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/litecc.js",
  "module": "./dist/litecc.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/litecc.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "demo": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@babylonjs/havok": "1.3.13",
    "@babylonjs/lite": "1.8.0"
  },
  "devDependencies": {
    "@babylonjs/havok": "1.3.13",
    "@babylonjs/lite": "1.8.0",
    "@types/node": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT"
}
